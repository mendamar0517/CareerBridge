# Хуулж .env нэртэй файл үүсгээд утгуудаа тохируулна (.env-г git-д оруулахгүй)
POSTGRES_USER=careerbridge
POSTGRES_PASSWORD=careerbridge
POSTGRES_DB=careerbridge
POSTGRES_PORT=5432

# API контейнерийн гадагш нээх порт
API_PORT=3000

# Backend (Prisma) холболт
DATABASE_URL="postgresql://careerbridge:careerbridge@localhost:5432/careerbridge?schema=public"

# Лаб 13: хяналт
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
